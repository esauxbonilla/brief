# Supabase. Sin estas variables la app arranca en modo demo (datos en memoria).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor: panel agencia y envío de avisos.
SUPABASE_SERVICE_ROLE_KEY=
# Avisos diarios (Vercel Cron manda este token como Bearer).
CRON_SECRET=
# WhatsApp Cloud API. Sin estas variables los avisos solo se registran en el log.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
